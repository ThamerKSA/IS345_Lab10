<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IS345_Lab10.Page1"
             Title="Page1"
             BackgroundImageSource="back">
    <ScrollView>
        <StackLayout>
            <CollectionView x:Name="collView" SelectionChanged="OnCollectionViewSelectionChanged" SelectionMode="Single"
                            HeightRequest="120" VerticalOptions="StartAndExpand" HorizontalOptions="Center">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="5">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="#F57C00" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="70" />
                                <RowDefinition Height="35" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <Border HeightRequest="60" WidthRequest="60" StrokeShape="RoundRectangle 30">
                                <Image Source="{Binding ImageUrl}" Aspect="AspectFill" HeightRequest="60" WidthRequest="60" />
                            </Border>
                            <Label Grid.Row="1" Text="{Binding cataTitle}" FontAttributes="Italic" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <StackLayout Margin="0,10,0,0">
                <ListView HasUnevenRows="true" x:Name="myListView" SelectionMode="Single" ItemSelected="myListView_ItemSelected">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <StackLayout VerticalOptions="CenterAndExpand" HorizontalOptions="Center">
                                    <Image Source="{Binding ImageUrl}" HeightRequest="60" WidthRequest="60" />
                                    <Label Text="{Binding Price, StringFormat='{0} SR'}" HorizontalOptions="Center" TextColor="#E61C1C" />
                                    <Label Text="{Binding Title}" />
                                    <Image Source="cart" HeightRequest="40" WidthRequest="80" />
                                </StackLayout>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackLayout>
        </StackLayout>
    </ScrollView>
</ContentPage>
