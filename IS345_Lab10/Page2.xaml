<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IS345_Lab10.Page2"
             Title="My Cart"
             BackgroundImageSource="back">

    <ScrollView>
        <VerticalStackLayout>

            <ListView HasUnevenRows="true" x:Name="myListView" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <ViewCell>
                            <StackLayout VerticalOptions="CenterAndExpand">
                                <Image Source="{Binding ImageUrl}" HeightRequest="60" WidthRequest="60" />
                                <Label Text="{Binding Price}" HorizontalOptions="Center" TextColor="#E61C1C" />
                                <Label Text="{Binding Title}" HorizontalOptions="Center" />
                                <Label Text="{Binding info}" TextColor="Green" />
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="Quantity" FontSize="22" VerticalOptions="Center" />
                                    <Label Text="{Binding Source={x:Reference stp}, Path=Value}" FontSize="22" VerticalOptions="Center" />
                                    <Stepper x:Name="stp" Minimum="0" Maximum="100" Increment="1"
                                             Value="{Binding quant, Mode=TwoWay}" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </StackLayout>
                        </ViewCell>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Text="buy"
                    BackgroundColor="Blue"
                    TextColor="White"
                    CornerRadius="25"
                    Margin="0,10,0,0"
                    Clicked="Button_Clicked_1" />

            <ImageButton Source="home"
                         HeightRequest="50"
                         WidthRequest="50"
                         CornerRadius="25"
                         HorizontalOptions="Center"
                         Margin="0,10"
                         Clicked="ImageButton_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
