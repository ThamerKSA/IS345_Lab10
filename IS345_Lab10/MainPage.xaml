<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="IS345_Lab10.MainPage"
             Title="Home">

    <ScrollView>
        <VerticalStackLayout Padding="15,10" Spacing="5">
            <Image Source="login.jpg"
                   HeightRequest="120"
                   WidthRequest="90"
                   Aspect="AspectFit"
                   HorizontalOptions="Center" />

            <Label Text="Peruzal"
                   TextColor="Gray"
                   HorizontalOptions="Center" />

            <Entry x:Name="txt1" Placeholder="Username" />

            <Entry x:Name="txt2" Placeholder="Password" IsPassword="True" />

            <Grid ColumnDefinitions="*,*" Margin="0,5,0,0">
                <Button Grid.Column="0"
                        Text="Login"
                        BackgroundColor="Orange"
                        TextColor="White"
                        Clicked="Button_Clicked" />
                <Button Grid.Column="1"
                        Text="Register"
                        BackgroundColor="Gray"
                        TextColor="White"
                        Clicked="Register_Clicked" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
